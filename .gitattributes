# Text files are stored and checked out with Unix line endings on every computer,
# so the same edit on a Windows laptop and a Mac produces the same diff.
* text=auto eol=lf

*.png   binary
*.jpg   binary
*.webp  binary
*.ico   binary
*.woff2 binary
*.pdf   binary
*.xlsx  binary
*.docx  binary
*.pptx  binary
*.zip   binary
